# Terraform and provider version constraints.
# Pin provider versions so plans are reproducible across local runs and CI.

terraform {
  required_version = ">= 1.7.0"

  required_providers {
    azurerm = {
      source  = "hashicorp/azurerm"
      version = "~> 4.0"
    }
    tls = {
      source  = "hashicorp/tls"
      version = "~> 4.0"
    }
    random = {
      source  = "hashicorp/random"
      version = "~> 3.6"
    }
    archive = {
      source  = "hashicorp/archive"
      version = "~> 2.4"
    }
  }

  # Remote state (e.g. Azure Blob Storage backend) is recommended for shared
  # environments but is not configured here. See README for the intended approach.
}
